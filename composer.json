{
    "name": "dev-toolbelt/enums",
    "description": "A shared set of open-source enums for frequently used domains, helping reduce duplication and improve consistency across software projects.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "enums",
        "php-enums",
        "backed-enum",
        "timezone",
        "algorithm",
        "jwt",
        "cryptography"
    ],
    "authors": [
        {
            "name": "Kilderson Sena",
            "email": "dersonsena@gmail.com"
        }
    ],
    "scripts": {
        "test": "phpunit --configuration tests/phpunit.xml",
        "test:coverage": "php -d pcov.enabled=1 -d pcov.directory=src vendor/bin/phpunit --configuration tests/phpunit-coverage.xml",
        "phpcs": "phpcs --standard=phpcs.xml",
        "phpcs:fix": "php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes",
        "phpstan": "phpstan analyse --configuration=phpstan.neon --memory-limit=512M"
    },
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "DevToolbelt\\Enums\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DevToolbelt\\Enums\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
